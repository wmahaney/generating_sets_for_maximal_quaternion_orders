/*
  q := 0 means "choose a fresh random auxiliary prime for each p, held fixed
  across the whole k-range"; supplying q pins it for the entire sweep.
*/
procedure sweep_bound_test_submaximal_index_q(p_min, p_max, l, k_min, k_max
        : trials := 5, q := 0, filename := "", verbose := true, prec := 10)
    R := RealField(prec);
    p := NextPrime(p_min - 1);
    while p le p_max do
        if p ne l then
            candidates := [x : x in sweep_q_candidates | x ne p and x ne l];
            qp := (q eq 0) select Random(candidates) else q;
            error if qp eq p, "auxiliary prime q must differ from p";
            steps := Ceiling(Log(l, p));
            result := [];
            for k in [k_min .. k_max] do
                Append(~result,
                    R ! bound_test_submaximal_index_q(p, l, k
                            : trials := trials, q := qp, steps := steps));
            end for;
            if verbose then
                print_python_result(p, l, k_min, k_max, result);
            end if;
            if filename ne "" then
                write_python_result_to_file(p, l, k_min, k_max, result, filename);
            end if;
        end if;
        p := NextPrime(p);
    end while;
end procedure;


procedure sweep_bound_test_submaximal_index_q2(p_min, p_max, l, k_min, k_max
        : trials := 5, q := 0, filename := "", verbose := true, prec := 10)
    R := RealField(prec);
    p := NextPrime(p_min - 1);
    while p le p_max do
        if p ne l then
            candidates := [x : x in sweep_q_candidates | x ne p and x ne l];
            qp := (q eq 0) select Random(candidates) else q;
            error if qp eq p, "auxiliary prime q must differ from p";
            steps := Ceiling(Log(l, p));
            result := [];
            for k in [k_min .. k_max] do
                Append(~result,
                    R ! bound_test_submaximal_index_q2(p, l, k
                            : trials := trials, q := qp, steps := steps));
            end for;
            if verbose then
                print_python_result(p, l, k_min, k_max, result);
            end if;
            if filename ne "" then
                write_python_result_to_file(p, l, k_min, k_max, result, filename);
            end if;
        end if;
        p := NextPrime(p);
    end while;
end procedure;


