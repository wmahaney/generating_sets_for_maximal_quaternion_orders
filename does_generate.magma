/*
================================================================================
  Bound-error and generation experiments for quaternion orders in B_{p,infty}

  Section order (functions are defined before first use so the file loads
  top-to-bottom):

    0. Configuration
    1. Auxiliary functions       (norm counting, generation test, bound error)
    2. Order construction        (maximal / submaximal types, random walk)
    3. Data printing             (Python-compatible output)
    4. Single-prime tests        (bound tests, phase-change check)
    5. Sweeps                    (ranges of p)
    6. Scratch / driver          (commented out)
================================================================================
*/


/*
================================================================================
  0. Configuration
================================================================================
*/

sweep_q_candidates := [5, 7, 11, 13, 17, 19, 23, 29, 31];


/*
================================================================================
  1. Auxiliary Functions
================================================================================
*/

function count_prime_power_norm(O, l, k)
    // Returns the number of elements of O of norm l^k, counting negatives.
    if k lt 0 then
        return 0;
    end if;
    if not IsPrime(l) then
        error "l must be prime";
    end if;

    return 2*#Enumerate(O, l^k, l^k);
end function;


function prime_power_norm_generates(O, l, k)
    // Test whether the elements of O of norm l^k generate O as a ring.
    if k lt 0 then
        return false;
    end if;
    if not IsPrime(l) then
        error "l must be prime";
    end if;

    test_set := [One(O)] cat Enumerate(O, l^k, l^k);
    vecs := [Eltseq(x) : x in test_set];
    H, _ := HermiteForm(Matrix(Integers(), vecs));
    H_rows := RowSequence(H);
    delete H;
    delete vecs;

    if #H_rows ge 4 then
        LLL_basis := [H_rows[1], H_rows[2], H_rows[3], H_rows[4]];
        M := Matrix(Integers(), LLL_basis);
        return Determinant(M) eq 1;
    else
        return false;
    end if;
end function;


/*
  Instead of measuring the bounds on rep numbers compared to the norm counts, we
  can instead compute the error
      |a_{l^k}(O) - g_{l^k}| / ( #Units(O) * 2 * k * l^{(k+2)/2} )
  for
      g_{l^k}(O) = lambda_{l^k}(O)/lambda_0(O)        (M_G(O) one dimensional)
      g_{l^k}(O) = (lambda_{l^k}(e) + lambda_{l^k}(e'))/lambda_0(e)
                 = lambda_{l^k}(e)/lambda_0(e) * (1 + LegendreSymbol(l^k, p))

  In general
      g_{l^k} - #Units(O)*2*k*l^((k+2)/2)
          <= a_{l^k}(O) <=
      g_{l^k} + #Units(O)*2*k*l^((k+2)/2).
*/

function check_bound_error(O, p, l, k)
    // Measure how much bigger g_{l^k} + ... is than a_{l^k}(O) when O is
    // maximal or submaximal, i.e. Discrd(O) in {p, p^2, p^3, pq, pq^2}.
    D := Discriminant(O);
    if l eq p then
        error "l must not be ramified in the quaternion algebra containing O";
    end if;

    // O has one genus vector if O is maximal (discriminant p), Eichler
    // (discriminant pq), of discriminant p^3, or of discriminant pq^2.
    // O has two genus vectors if O has discriminant p^2.

    // lambda_0(e) given by figure (22) as
    //     EulerPhi(Discriminant(QuaternionAlgebra(O)))/24 * (correction factor)
    lambda_0_e := EulerPhi(Discriminant(QuaternionAlgebra(O)))/24;

    correction_factor := 1;
    if D eq p then                              // maximal
        correction_factor := 1;
    elif IsPrime(D div p) then                  // Eichler, D = pq
        correction_factor := 1 + PrimeDivisors(D div p)[1];
    elif D eq p^2 then                          // index p
        correction_factor := p + 1;
    elif D eq p^3 then
        correction_factor := p^2;
    else                                        // index pq^2
        q := PrimeDivisors(D div p)[1];
        correction_factor := q*(q - 1);
    end if;
    lambda_0_e := lambda_0_e*correction_factor;

    // lambda_{l^k}(e)
    lambda_lk_e := 0;
    if not l in Divisors(D) then                // O is maximal at l
        lambda_lk_e := ( l^(k+1) - 1 )/( l - 1 );
    elif D/p eq l then
        lambda_lk_e := -1 + 2*( ( l^(k+1) - 1 )/( l - 1 ) );
    else                                        // D/p eq q^2
        lambda_lk_e := l^k - l;
    end if;

    if D eq p^2 then                            // O has 2 genus vectors
        glk := ( lambda_lk_e/lambda_0_e )*( 1 + JacobiSymbol(l^k, p) );
    else
        glk := lambda_lk_e/lambda_0_e;
    end if;

    alk := count_prime_power_norm(O, l, k);

    return AbsoluteValue(alk - glk)/( 2*k*l^((k+2)/2)*#Units(O) );
end function;


/*
================================================================================
  2. Order Construction
================================================================================
*/

/*
